<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_licensed_trade" targetNamespace="https://doingprocess.org/bpmn" exporter="doingprocess build_diagrams.py" exporterVersion="1">
  <bpmn:collaboration id="Collab_licensed_trade">
    <bpmn:participant id="Participant_licensed_trade" name="Getting licensed in a regulated trade" processRef="Process_licensed_trade" />
  </bpmn:collaboration>
  <bpmn:process id="Process_licensed_trade" name="Getting licensed in a regulated trade" isExecutable="false">
    <bpmn:documentation>Barbering, cosmetology, contracting, HVAC and many other trades need a state license. This is the path through the board, including the record screen most states now apply, and what happens while you wait.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_licensed_trade">
      <bpmn:lane id="Lane_licensed_trade_0" name="Entrepreneur">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lookup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nolic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>predet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>got</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>late</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>followup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_licensed_trade_1" name="Licensing board">
        <bpmn:flowNodeRef>board_pre</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="A trade in mind">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="lookup" name="Look up: does this trade need a state license?">
      <bpmn:documentation>Authority: DMN license_required</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="g1" name="License required?">
      <bpmn:documentation>Authority: Survey B3, E2</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="nolic" name="No state license. Go set up the business.">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="screen" name="Screen your record against the board's rules">
      <bpmn:documentation>Authority: Va. Code § 54.1-204</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="g2" name="Possible barrier?">
      <bpmn:documentation>Authority: Survey E3, E4</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="predet" name="Ask the board for an early determination (where offered)">
      <bpmn:documentation>Authority: CITATION NEEDED</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="board_pre" name="Weigh the record: relation to the trade, time passed, rehabilitation">
      <bpmn:documentation>Authority: Va. Code § 54.1-204(B)</bpmn:documentation>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="train" name="Finish the training hours and pass the exam">
      <bpmn:documentation>Authority: CITATION NEEDED; Can start before release: yes</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="apply" name="Apply and pay the fee">
      <bpmn:documentation>Authority: CITATION NEEDED</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="wait" name="Wait for the board">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="got" name="License issued">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_got" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="denied" name="Denied">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_denied" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="late" name="No answer after 30 days">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_late"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="appeal" name="Ask for the reasons in writing; request a hearing">
      <bpmn:documentation>Authority: Va. Code § 2.2-4019</bpmn:documentation>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="followup" name="Follow up with the board">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end" name="Licensed">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end2" name="Hearing outcome">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="s" targetRef="lookup" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="lookup" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="g1" targetRef="nolic" name="no" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="g1" targetRef="screen" name="yes" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="screen" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="g2" targetRef="predet" name="yes" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="g2" targetRef="train" name="no" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="predet" targetRef="board_pre" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="board_pre" targetRef="train" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="train" targetRef="apply" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="apply" targetRef="wait" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="wait" targetRef="got" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="wait" targetRef="denied" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="wait" targetRef="late" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="got" targetRef="end" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="denied" targetRef="appeal" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="late" targetRef="followup" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="followup" targetRef="wait" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="appeal" targetRef="end2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_licensed_trade">
    <bpmndi:BPMNPlane id="Plane_licensed_trade" bpmnElement="Collab_licensed_trade">
      <bpmndi:BPMNShape id="Participant_licensed_trade_di" bpmnElement="Participant_licensed_trade" isHorizontal="true"><dc:Bounds x="26" y="38" width="2354" height="428" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_licensed_trade_0_di" bpmnElement="Lane_licensed_trade_0" isHorizontal="true"><dc:Bounds x="56" y="44" width="2324" height="312" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_licensed_trade_1_di" bpmnElement="Lane_licensed_trade_1" isHorizontal="true"><dc:Bounds x="56" y="356" width="2324" height="104" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="136" y="77" width="38" height="38" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lookup_di" bpmnElement="lookup"><dc:Bounds x="259" y="59" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1"><dc:Bounds x="487" y="72" width="48" height="48" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="nolic_di" bpmnElement="nolic"><dc:Bounds x="670" y="181" width="38" height="38" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="screen_di" bpmnElement="screen"><dc:Bounds x="615" y="59" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g2_di" bpmnElement="g2"><dc:Bounds x="843" y="72" width="48" height="48" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="predet_di" bpmnElement="predet"><dc:Bounds x="971" y="163" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="board_pre_di" bpmnElement="board_pre"><dc:Bounds x="1149" y="371" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="train_di" bpmnElement="train"><dc:Bounds x="1327" y="59" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="apply_di" bpmnElement="apply"><dc:Bounds x="1505" y="59" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_di" bpmnElement="wait"><dc:Bounds x="1733" y="72" width="48" height="48" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="got_di" bpmnElement="got"><dc:Bounds x="1916" y="77" width="38" height="38" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="denied_di" bpmnElement="denied"><dc:Bounds x="1916" y="181" width="38" height="38" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="late_di" bpmnElement="late"><dc:Bounds x="1916" y="285" width="38" height="38" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="appeal_di" bpmnElement="appeal"><dc:Bounds x="2039" y="163" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="followup_di" bpmnElement="followup"><dc:Bounds x="2039" y="267" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="2272" y="77" width="38" height="38" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end2_di" bpmnElement="end2"><dc:Bounds x="2272" y="181" width="38" height="38" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0"><di:waypoint x="174" y="96" /><di:waypoint x="259" y="96" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="407" y="96" /><di:waypoint x="487" y="96" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="511" y="120" /><di:waypoint x="511" y="200" /><di:waypoint x="670" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="535" y="96" /><di:waypoint x="615" y="96" /></bpmndi:BPMNEdge>
