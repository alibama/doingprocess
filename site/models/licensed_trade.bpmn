      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1297" y="408" /><di:waypoint x="1312" y="408" /><di:waypoint x="1312" y="96" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="1475" y="96" /><di:waypoint x="1505" y="96" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1653" y="96" /><di:waypoint x="1733" y="96" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1781" y="96" /><di:waypoint x="1916" y="96" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1757" y="120" /><di:waypoint x="1757" y="200" /><di:waypoint x="1916" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1757" y="120" /><di:waypoint x="1757" y="304" /><di:waypoint x="1916" y="304" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14"><di:waypoint x="1954" y="96" /><di:waypoint x="2272" y="96" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15"><di:waypoint x="1954" y="200" /><di:waypoint x="2039" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16"><di:waypoint x="1954" y="304" /><di:waypoint x="2039" y="304" /></bpmndi:BPMNEdge>
