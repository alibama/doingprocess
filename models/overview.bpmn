<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_overview" targetNamespace="https://doingprocess.org/bpmn" exporter="doingprocess build_diagrams.py" exporterVersion="1">
  <bpmn:collaboration id="Collab_overview">
    <bpmn:participant id="Participant_overview" name="Starting a business after release: the whole road" processRef="Process_overview" />
  </bpmn:collaboration>
  <bpmn:process id="Process_overview" name="Starting a business after release: the whole road" isExecutable="false">
    <bpmn:documentation>The end-to-end path from a release date to an open business. Each box with a plus sign is its own smaller process; survey answers decide which of them a person actually needs.</bpmn:documentation>
    <bpmn:startEvent id="s" name="Release within 12 months">
      <bpmn:documentation>Authority: Survey A1</bpmn:documentation>
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_s"></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:userTask id="survey" name="Take the readiness survey">
      <bpmn:documentation>Authority: Survey A–H; Can start before release: yes</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_sup" name="Supervision after release?">
      <bpmn:documentation>Authority: Survey A5, E5</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="po" name="Check your business plans with your PO">
      <bpmn:documentation>Authority: release conditions; Role: probation / parole</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="id" name="Get your ID">
      <bpmn:documentation>Can start before release: yes; Role: DMV · SSA · vital records</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="entity" name="Choose how to own it">
      <bpmn:documentation>Authority: Survey B5; Role: State Corporation Commission</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="bank" name="Open a bank account">
      <bpmn:documentation>Authority: Survey D1, D2; Role: bank or credit union</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:parallelGateway id="split" name="at the same time">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:subProcess id="lic" name="Licenses &amp; permits">
      <bpmn:documentation>Authority: Survey B3, E3, E4; Role: board · locality</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="tax" name="Taxes &amp; records">
      <bpmn:documentation>Authority: Survey F3, F4; Role: IRS · Va. Tax</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="money" name="Start-up money">
      <bpmn:documentation>Authority: Survey F1, F2; Role: CDFI · SBA · family</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:parallelGateway id="join" name="all done">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="g_ben" name="Getting SNAP, SSI or Medicaid?">
      <bpmn:documentation>Authority: Survey F5</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ben" name="Benefits counseling before income starts">
      <bpmn:documentation>Authority: CITATION NEEDED; Role: benefits counselor</bpmn:documentation>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end" name="Open for business">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="s" targetRef="survey" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="survey" targetRef="g_sup" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="g_sup" targetRef="po" name="yes" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="g_sup" targetRef="id" name="no" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="po" targetRef="id" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="id" targetRef="entity" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="entity" targetRef="bank" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="bank" targetRef="split" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="split" targetRef="lic" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="split" targetRef="tax" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="split" targetRef="money" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="lic" targetRef="join" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="tax" targetRef="join" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="money" targetRef="join" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="join" targetRef="g_ben" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="g_ben" targetRef="ben" name="yes" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="g_ben" targetRef="end" name="no" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="ben" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_overview">
    <bpmndi:BPMNPlane id="Plane_overview" bpmnElement="Collab_overview">
      <bpmndi:BPMNShape id="Participant_overview_di" bpmnElement="Participant_overview" isHorizontal="true"><dc:Bounds x="26" y="38" width="2314" height="336" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="96" y="79" width="38" height="38" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="survey_di" bpmnElement="survey"><dc:Bounds x="219" y="61" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_sup_di" bpmnElement="g_sup"><dc:Bounds x="447" y="74" width="48" height="48" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="po_di" bpmnElement="po"><dc:Bounds x="575" y="169" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="id_di" bpmnElement="id" isExpanded="false"><dc:Bounds x="753" y="61" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="entity_di" bpmnElement="entity" isExpanded="false"><dc:Bounds x="931" y="61" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bank_di" bpmnElement="bank" isExpanded="false"><dc:Bounds x="1109" y="61" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="split_di" bpmnElement="split"><dc:Bounds x="1337" y="74" width="48" height="48" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lic_di" bpmnElement="lic" isExpanded="false"><dc:Bounds x="1465" y="61" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tax_di" bpmnElement="tax" isExpanded="false"><dc:Bounds x="1465" y="169" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="money_di" bpmnElement="money" isExpanded="false"><dc:Bounds x="1465" y="277" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="join_di" bpmnElement="join"><dc:Bounds x="1693" y="74" width="48" height="48" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_ben_di" bpmnElement="g_ben"><dc:Bounds x="1871" y="74" width="48" height="48" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ben_di" bpmnElement="ben"><dc:Bounds x="1999" y="169" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="2232" y="79" width="38" height="38" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0"><di:waypoint x="134" y="98" /><di:waypoint x="219" y="98" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="367" y="98" /><di:waypoint x="447" y="98" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="471" y="122" /><di:waypoint x="471" y="206" /><di:waypoint x="575" y="206" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="495" y="98" /><di:waypoint x="753" y="98" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="723" y="206" /><di:waypoint x="738" y="206" /><di:waypoint x="738" y="98" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="901" y="98" /><di:waypoint x="931" y="98" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="1079" y="98" /><di:waypoint x="1109" y="98" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="1257" y="98" /><di:waypoint x="1337" y="98" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1385" y="98" /><di:waypoint x="1465" y="98" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="1361" y="122" /><di:waypoint x="1361" y="206" /><di:waypoint x="1465" y="206" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1361" y="122" /><di:waypoint x="1361" y="314" /><di:waypoint x="1465" y="314" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1613" y="98" /><di:waypoint x="1693" y="98" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1613" y="206" /><di:waypoint x="1717" y="206" /><di:waypoint x="1717" y="122" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1613" y="314" /><di:waypoint x="1717" y="314" /><di:waypoint x="1717" y="122" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14"><di:waypoint x="1741" y="98" /><di:waypoint x="1871" y="98" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15"><di:waypoint x="1895" y="122" /><di:waypoint x="1895" y="206" /><di:waypoint x="1999" y="206" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16"><di:waypoint x="1919" y="98" /><di:waypoint x="2232" y="98" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_17_di" bpmnElement="Flow_17"><di:waypoint x="2147" y="206" /><di:waypoint x="2162" y="206" /><di:waypoint x="2162" y="98" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
