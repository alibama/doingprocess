      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1425" y="96" /><di:waypoint x="1911" y="96" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1653" y="616" /><di:waypoint x="1683" y="616" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1831" y="616" /><di:waypoint x="1935" y="616" /><di:waypoint x="1935" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1935" y="120" /><di:waypoint x="1935" y="200" /><di:waypoint x="2039" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14"><di:waypoint x="1959" y="96" /><di:waypoint x="2450" y="96" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15"><di:waypoint x="2187" y="200" /><di:waypoint x="2202" y="200" /><di:waypoint x="2202" y="616" /><di:waypoint x="2217" y="616" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16"><di:waypoint x="2365" y="616" /><di:waypoint x="2380" y="616" /><di:waypoint x="2380" y="96" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
