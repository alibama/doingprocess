      <bpmndi:BPMNShape id="staff_bc_di" bpmnElement="staff_bc"><dc:Bounds x="437" y="267" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="vr_di" bpmnElement="vr"><dc:Bounds x="615" y="371" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="vr_t_di" bpmnElement="vr_t"><dc:Bounds x="731" y="357" width="28" height="28" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_ss_di" bpmnElement="g_ss"><dc:Bounds x="843" y="72" width="48" height="48" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="staff_ss_di" bpmnElement="staff_ss"><dc:Bounds x="971" y="267" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ssa_di" bpmnElement="ssa"><dc:Bounds x="1149" y="475" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_id_di" bpmnElement="g_id"><dc:Bounds x="1377" y="72" width="48" height="48" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dmvc_di" bpmnElement="dmvc"><dc:Bounds x="1505" y="579" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_dmv_di" bpmnElement="n_dmv"><dc:Bounds x="1479" y="165" width="200" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Assoc_n_dmv_di" bpmnElement="Assoc_n_dmv"><di:waypoint x="1425" y="96" /><di:waypoint x="1479" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="dmv_issue_di" bpmnElement="dmv_issue"><dc:Bounds x="1683" y="579" width="148" height="74" /></bpmndi:BPMNShape>
