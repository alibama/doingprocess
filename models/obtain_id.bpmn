      <bpmndi:BPMNShape id="g_dl_di" bpmnElement="g_dl"><dc:Bounds x="1911" y="72" width="48" height="48" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reinstate_di" bpmnElement="reinstate"><dc:Bounds x="2039" y="163" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dmv_re_di" bpmnElement="dmv_re"><dc:Bounds x="2217" y="579" width="148" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="2450" y="77" width="38" height="38" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0"><di:waypoint x="174" y="96" /><di:waypoint x="309" y="96" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="333" y="120" /><di:waypoint x="333" y="304" /><di:waypoint x="437" y="304" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="357" y="96" /><di:waypoint x="843" y="96" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="585" y="304" /><di:waypoint x="600" y="304" /><di:waypoint x="600" y="408" /><di:waypoint x="615" y="408" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="763" y="408" /><di:waypoint x="867" y="408" /><di:waypoint x="867" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="867" y="120" /><di:waypoint x="867" y="304" /><di:waypoint x="971" y="304" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="891" y="96" /><di:waypoint x="1377" y="96" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="1119" y="304" /><di:waypoint x="1134" y="304" /><di:waypoint x="1134" y="512" /><di:waypoint x="1149" y="512" /></bpmndi:BPMNEdge>
